{
  "mode": 60,
  "title": "龙伯格观测器无感 FOC 速度/电流双闭环（编码器角作裁判）",
  "entry": "comm_mode = 60",
  "pre": "必须先跑 mode 24 校准；否则 Foc_Luen60_Start 直接拒绝（RTT 打 ERROR），g_luen60_running 保持 0",
  "end": "持续运行不自动停；过流自动停（g_luen60_state=2 / evt=1）；手动停 comm_mode = 0",
  "watch": [
    {
      "mk": "",
      "name": "g_luen60_speed_target_rpm",
      "val": "0",
      "unit": "rpm",
      "desc": "目标转速；自动爬坡期间被覆盖"
    },
    {
      "mk": "",
      "name": "g_luen60_auto_ramp",
      "val": "1",
      "unit": "-",
      "desc": "启动自动爬坡；0=纯手动给目标"
    },
    {
      "mk": "(*)",
      "note": "自动爬坡 profile：秒 0/1/2/3 -> 0/200/500/1000 rpm（表 s_auto_rpm）。t < 4s 期间固件每拍写目标，Watch 改值会被立刻覆盖；t >= 4s 起停止写入，交还 Watch。要全程手动就在进模式前把 g_luen60_auto_ramp 置 0。"
    },
    {
      "mk": "",
      "name": "g_luen60_sensorless",
      "val": "0",
      "unit": "-",
      "desc": "1=切无感（需 g_luen_emf_ok=1）"
    },
    {
      "mk": "",
      "name": "g_luen60_ang_lead_ticks",
      "val": "1.5",
      "unit": "tick",
      "desc": "有感角度超前补偿拍数，0=关"
    },
    {
      "mk": "",
      "name": "g_luen60_iq_filt_alpha",
      "val": "0.10",
      "unit": "-",
      "desc": "iq 反馈滤波系数（显示用）"
    },
    {
      "mk": "",
      "name": "g_luen60_wave_mode",
      "val": "0",
      "unit": "-",
      "desc": "VOFA 布局选择（见通道表）"
    },
    {
      "mk": "",
      "name": "g_luen60_pid_speed_cfg.kp",
      "val": "0.8",
      "unit": "mA/rpm",
      "desc": "速度环 P（Watch 改立即生效）"
    },
    {
      "mk": "",
      "name": "g_luen60_pid_speed_cfg.ki",
      "val": "0.03",
      "unit": "mA/rpm/s",
      "desc": "速度环 I"
    },
    {
      "mk": "",
      "name": "g_luen60_pid_id_cfg.kp",
      "val": "0.1",
      "unit": "V/A",
      "desc": "电流环 P（d 轴）"
    },
    {
      "mk": "",
      "name": "g_luen60_pid_iq_cfg.kp",
      "val": "0.1",
      "unit": "V/A",
      "desc": "电流环 P（q 轴）"
    },
    {
      "mk": "",
      "name": "g_luen60_pid_id_cfg.ki",
      "val": "300",
      "unit": "V/A/s",
      "desc": "电流环 I（d 轴）"
    },
    {
      "mk": "",
      "name": "g_luen60_pid_iq_cfg.ki",
      "val": "300",
      "unit": "V/A/s",
      "desc": "电流环 I（q 轴）"
    },
    {
      "mk": "(*)",
      "note": "上 6 行与 mode 40 / mode 45 同源定稿值（电流 kp 0.1 / ki 300、速度 kp 0.8 / ki 0.03），便于两种观测器直接 A/B 对比。id / iq 两个 kp 必须同步改。"
    },
    {
      "mk": "",
      "name": "g_luen_model_r_ohm",
      "val": "0.1",
      "unit": "ohm",
      "desc": "模型定子电阻 R；错则幅值/相位偏"
    },
    {
      "mk": "",
      "name": "g_luen_model_l_h",
      "val": "42.3e-6",
      "unit": "H",
      "desc": "模型电感 L（表贴式 Ld=Lq）"
    },
    {
      "mk": "",
      "name": "g_luen_model_psi_wb",
      "val": "0.00084",
      "unit": "Wb",
      "desc": "模型磁链 psi_f；理论幅值用它"
    },
    {
      "mk": "(*)",
      "name": "g_luen_omega_o",
      "val": "4712",
      "unit": "rad/s",
      "desc": "观测器带宽 Omega_o（极点 -Omega_o）"
    },
    {
      "mk": "(*)",
      "note": "Omega_o 是龙伯格唯一的核心旋钮：建议取电流环带宽 kp/L 约 2364 rad/s 的 2~5 倍，默认 4712（= 2pi x 750）。连续极点全转速都在左半平面，无硬上限；固件 e_hat 旋转项已改用精确旋转 R(omega_hat*Ts)（模恒为 1），离散极点由 -l2*err 修正项压进单位圆内，7800rpm 下谱半径约 0.985<1，全转速段稳定，详见 foc_luen.h。过大 = 高频抖动/噪声；过小 = 收敛慢、相位滞后大。"
    },
    {
      "mk": "",
      "name": "g_luen_emax_v",
      "val": "20",
      "unit": "V",
      "desc": "反电动势发散保护上限 |e_hat|"
    },
    {
      "mk": "",
      "name": "g_luen_ih_clamp_a",
      "val": "40",
      "unit": "A",
      "desc": "观测器电流数值钳位"
    },
    {
      "mk": "",
      "name": "g_luen_jdg_rpm_min",
      "val": "900",
      "unit": "rpm",
      "desc": "反电动势判定生效转速下限"
    },
    {
      "mk": "",
      "name": "g_luen_jdg_ratio_min",
      "val": "0.85",
      "unit": "-",
      "desc": "C1 幅值比下限"
    },
    {
      "mk": "",
      "name": "g_luen_jdg_ratio_max",
      "val": "1.08",
      "unit": "-",
      "desc": "C1 幅值比上限"
    },
    {
      "mk": "",
      "name": "g_luen_jdg_phase_min_deg",
      "val": "-45",
      "unit": "deg",
      "desc": "C2 相位下限"
    },
    {
      "mk": "",
      "name": "g_luen_jdg_phase_max_deg",
      "val": "5",
      "unit": "deg",
      "desc": "C2 相位上限"
    },
    {
      "mk": "",
      "name": "g_luen_jdg_hold_ms",
      "val": "1000",
      "unit": "ms",
      "desc": "判定连续满足时长"
    },
    {
      "mk": "",
      "name": "g_luen_jdg_filt_alpha",
      "val": "0.02",
      "unit": "-",
      "desc": "判定级慢速 EMA 系数"
    },
    {
      "mk": "",
      "name": "g_pll_comp_en",
      "val": "0",
      "unit": "-",
      "desc": "1=PLL 补偿角生效（默认关）"
    },
    {
      "mk": "[!]",
      "note": "PLL 补偿公式（g_pll_comp_en=1 时）按 SMO 的 LPF 迟滞口径推导，对龙伯格不适用；默认关，确实要补相位请只调 g_pll_comp_bias_deg 手填。"
    }
  ],
