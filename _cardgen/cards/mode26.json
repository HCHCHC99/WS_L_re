{
  "mode": 26,
  "title": "开环 VF 负载角实验（磁场按时间自转，扫频看 delta 与失步）",
  "entry": "comm_mode = 26",
  "pre": "无。进入即自带校准：BETA 90deg 吸 2s -> ALPHA 0deg 吸 2s 锁零点（约 4s 后进 DRAG）",
  "end": "持续拖动到手动停机（SW2 短按或写 comm_mode = 0）；仅过流自动回 mode 0",
  "watch": [
    {
      "mk": "",
      "name": "g_olf_freq_init_hz",
      "val": "0.2",
      "unit": "Hz",
      "desc": "斜坡起点（Start 不复位）"
    },
    {
      "mk": "",
      "name": "g_olf_freq_targ_hz",
      "val": "150.0",
      "unit": "Hz",
      "desc": "斜坡终点（SW1 每按 +0.5）"
    },
    {
      "mk": "",
      "name": "g_olf_freq_tr_ms",
      "val": "20000",
      "unit": "ms",
      "desc": "过渡时间，0=立即"
    },
    {
      "mk": "",
      "name": "g_olf_volt_v",
      "val": "0.6",
      "unit": "V",
      "desc": "拖动电压，Start 复位 0.6"
    },
    {
      "mk": "",
      "name": "g_olf_step_010",
      "val": "1",
      "unit": "0.1deg",
      "desc": "自增步长，1 约等于连续旋转"
    },
    {
      "mk": "",
      "name": "g_olf_dir",
      "val": "1",
      "unit": "-",
      "desc": "自增方向 +1=角加 / -1=角减"
    },
    {
      "mk": "(*)",
      "note": "默认值取 .c 初始化：0.2Hz 起步、20s 爬到 150Hz 自动扫频；.h 速览卡写的 0.5 与交接.md 写的 3Hz 与此不一致。"
    },
    {
      "mk": "[!]",
      "note": "g_olf_step_010 / g_olf_dir 在 Start 会复位成 1 / +1；想用大步长做跳跃实验，必须在启动之后再改。"
    }
  ],
