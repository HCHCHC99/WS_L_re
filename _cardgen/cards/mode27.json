      { "mk": "", "ch": "ch10", "what": "电压幅值", "unit": "V", "desc": "= 本模式调速旋钮" },
      { "mk": "", "ch": "ch11", "what": "iq 峰峰值", "unit": "A", "desc": "5s 窗口刷新，猎振判据" },
      { "mk": "", "ch": "ch12", "what": "id 峰峰值", "unit": "A", "desc": "5s 窗口刷新" },
      { "mk": "", "ch": "ch13", "what": "U 相占空比", "unit": "%", "desc": "" },
      { "mk": "", "ch": "ch14", "what": "V 相占空比", "unit": "%", "desc": "" },
      { "mk": "", "ch": "ch15", "what": "W 相占空比", "unit": "%", "desc": "" },
      { "mk": "", "ch": "ch16", "what": "状态", "unit": "-", "desc": "0IDLE/1BETA/2ALPHA/3RUN/4OC" }
    ]
  },
  "notes": [
    { "mk": "(*)", "text": "主判据：delta 钉死后转速改由电压决定。扫 g_dcl_dlt_targ_deg 5/30/45/60/75/89，g_dcl_speed_hz 峰值应在 90deg 附近（MTPA 闭环验证）。" },
    { "mk": "(*)", "text": "实测：delta=90deg、volt=0.6V 稳态约 460Hz 电频（约 2760rpm），id 转负、iq 降到摩擦级，即电压被 BEMF 吃掉的平衡点。" },
    { "mk": "[!]", "text": "diff（ch5）= fold(field - rotor) 与 dlt_now（ch4）同源，两者相等只验证数学，不是真功角；要独立判据看 id/iq 矢量角 atan2(iq, id)。" },
    { "mk": "[!]", "text": "g_dcl_speed_hz 符号取原始计数方向（未乘 g_foc_enc_dir），可能与实际转向相反；判 MTPA 只看幅值趋势。" },
    { "mk": "[!]", "text": "高速下半拍滞后使实际 delta 比设定大 w*Ts/2（100~300Hz 约 1~3deg），要准就把 targ 少设 1~2deg；delta 小角度 id 大（铜损约 2W），长跑注意温升。" }
  ],
