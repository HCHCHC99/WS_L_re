{
  "mode": 27,
  "title": "功角闭环拖动（磁场 = 转子角 + delta，delta 钉死不失步）",
  "entry": "comm_mode = 27",
  "pre": "无。进入即自带校准：BETA 90deg 吸 2s -> ALPHA 0deg 吸 2s 锁零点（约 4s 后自动 RUN）",
  "end": "持续运行到手动停机（SW2 短按或写 comm_mode = 0）；仅过流自动回 mode 0",
  "watch": [
    { "mk": "", "name": "g_dcl_volt_v", "val": "0.6", "unit": "V", "desc": "调速旋钮（0.1V 约 1A）" },
    { "mk": "", "name": "g_dcl_dlt_init_deg", "val": "5", "unit": "deg", "desc": "delta 爬坡起点（不复位）" },
    { "mk": "", "name": "g_dcl_dlt_targ_deg", "val": "45", "unit": "deg", "desc": "delta 爬坡终点（扫 MTPA）" },
    { "mk": "", "name": "g_dcl_dlt_tr_ms", "val": "2000", "unit": "ms", "desc": "过渡时间，0=立即" },
    { "mk": "(*)", "note": "实测：delta=90deg、volt=0.6V 时稳态约 460Hz 电频（约 2760rpm），id 转负、iq 降到摩擦级电流。" },
    { "mk": "[!]", "note": "功角三参数 Start 不复位（可预设后启动），g_dcl_volt_v 则每次 Start 复位 0.6；运行中改参数 = 按新值重算轨迹并跳变，实验前先设好。" }
  ],
