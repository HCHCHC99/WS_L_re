    { "mk": "", "name": "g_dcl_rotor_deg", "desc": "转子电角 (deg，0~359)" },
    { "mk": "", "name": "g_dcl_enc_pos", "desc": "相对计数镜像（毛刺/限幅排查用）" },
    { "mk": "", "name": "g_dcl_state", "desc": "0IDLE/1BETA/2ALPHA/3RUN/4OC" },
    { "mk": "", "name": "g_dcl_evt", "desc": "事件 1BETA/2LOCKED/3RAMP/4OC" },
    { "mk": "", "name": "g_dcl_running", "desc": "1 = 正在运行（切模式后清零）" },
    { "mk": "", "name": "g_dcl_offset", "desc": "校准锁零点（hw 绝对帧 counts）" },
