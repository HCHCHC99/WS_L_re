{
  "mode": 20,
  "title": "编码器零点校准（BETA 2s + ALPHA 2s 自动锁零点）",
  "entry": "comm_mode = 20",
  "pre": "无；进模式即清故障 + 零矢量起 PWM，转子需能自由转动",
  "end": "约 4s 自动：锁零点 + 关 PWM + 自动回 mode 0。LOCKED 和过流都自动回 0",
  "watch": [
    {
      "mk": "",
      "name": "g_lockiq_align_volt_v",
      "val": "0.4",
      "unit": "V",
      "desc": "吸附电压（复用 mode 32）"
    },
    {
      "mk": "",
      "name": "g_foc_enc_dir",
      "val": "-1",
      "unit": "-",
      "desc": "编码器方向，参与零点计算"
    },
    {
      "mk": "(*)",
      "note": "0.4V 实测吸持约 4A 直流（Rs 约 0.1 欧），在 9A 过流阈值内。本模式没有自己的电压变量，改的就是 mode 32 的 g_lockiq_align_volt_v（宏默认 FOC_ALIGN_VOLT_V）。"
    },
    {
      "mk": "[!]",
      "note": "电压改成 0 等于没打磁场，但事件照样报 LOCKED，锁出废零点（g_cal_moved 约 0）；抬到约 0.9V 以上会撞 9A 过流，g_cal_evt = 3 并自动回 mode 0。"
    }
  ],
  "obs": [
    {
      "mk": "",
      "name": "g_cal_running",
      "desc": "1 = 校准运行中；锁定或过流后自动回 0"
    },
    {
      "mk": "",
      "name": "g_cal_phase",
      "desc": "0 BETA / 1 ALPHA / 2 DONE / 3 FAULT_OC"
    },
    {
      "mk": "",
      "name": "g_cal_evt",
      "desc": "1 BETA_DONE / 2 LOCKED / 3 OC"
    },
    {
      "mk": "",
      "name": "g_cal_beta_hw",
      "desc": "BETA 结束时 TMRA_1 原始计数"
    },
    {
      "mk": "",
      "name": "g_cal_alpha_hw",
      "desc": "ALPHA 结束时 TMRA_1 原始计数"
    },
    {
      "mk": "(*)",
      "name": "g_cal_moved",
      "desc": "BETA->ALPHA 位移 counts（应约 +/-102）"
    },
    {
      "mk": "(*)",
      "name": "g_cal_offset",
      "desc": "锁定的零点 counts，已写入共享对齐零点"
    },
    {
      "mk": "",
      "name": "g_foc_elec_deg",
      "desc": "mode 0 实时电角度 deg（范围 0-3600）"
    },
    {
      "mk": "",
      "name": "g_foc_fault",
      "desc": "非 0 = 故障停机（过流）"
    },
    {
      "mk": "",
      "name": "g_foc_fault_i_ma",
      "desc": "过流时刻最大相电流 mA"
    },
    {
      "mk": "[!]",
      "note": "纯定时、无吸稳校验：BETA 到 2s 就无条件记 g_cal_beta_hw 并切 ALPHA。转子初始还在转、被齿槽卡住或相序不对时，事件仍然报 LOCKED，零点已经错了。"
    },
    {
      "mk": "[!]",
      "note": "中途改 comm_mode 走 Foc_Cal_Stop()：只清运行标志 + 关 PWM，不写 offset，也不清 g_cal_phase / g_cal_evt，看到停在 0 或 1 属正常。"
    }
  ],
  "vofa": {
    "n": 14,
    "fn": "Foc_Cal_VofaFill",
    "shared": false,
    "rows": [
      {
        "mk": "",
        "ch": "ch0",
        "what": "U 相电流",
        "unit": "A",
        "desc": "BETA/ALPHA 吸附电流包络"
      },
      {
        "mk": "",
