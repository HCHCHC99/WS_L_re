{
  "mode": 25,
  "title": "手动角度吸附（写电角度，把转子吸过去并校验）",
  "entry": "comm_mode = 25",
  "pre": "无；进入后自动先跑校准（BETA 90 度 2s -> ALPHA 0 度 2s 锁零点）",
  "end": "吸附 2s + 校验 0.5s 后自动回刹车 50/50/50 停在 25 等下一次输入；只有过流自动回 mode 0",
  "watch": [
    {
      "mk": "(*)",
      "name": "g_foc_angle_input",
      "val": "0",
      "unit": "x0.1deg",
      "desc": "目标电角度，改值即触发吸附"
    },
    {
      "mk": "[!]",
      "note": "同一个值再写一次不会触发（改值检测），要先写别的值再写回来；校准 4s 期间预设的值会在锁零点后立即执行。"
    },
    {
      "mk": "",
      "name": "g_calang_volt_v",
      "val": "0.4",
      "unit": "V",
      "desc": "吸附电压（约 4A）"
    },
    {
      "mk": "[!]",
      "note": "经验上限 0.55V（约 5.5A）。注意宏 FOC_OC_LIMIT_A 实际是 9.0A，提压时不要只看宏。"
    },
    {
      "mk": "",
      "name": "g_calang_stable_cnts",
      "val": "8",
      "unit": "counts",
      "desc": "校验窗静止判据，越小越严"
    }
  ],
