		{"id":"e3","fromNode":"n_decoff","fromSide":"bottom","toNode":"n_capdir","toSide":"top","label":"是"},
		{"id":"e4","fromNode":"n_capdir","fromSide":"bottom","toNode":"n_calib","toSide":"top"},
		{"id":"e5","fromNode":"n_calib","fromSide":"bottom","toNode":"n_loop","toSide":"top"},
		{"id":"e6","fromNode":"n_loop","fromSide":"bottom","toNode":"n_check","toSide":"top"},
		{"id":"e7","fromNode":"n_check","fromSide":"left","toNode":"n_loop","toSide":"left","color":"4","label":"正常（继续闭环）"},
		{"id":"e8","fromNode":"n_check","fromSide":"right","toNode":"n_stall","toSide":"left","color":"2","label":"没动"},
		{"id":"e9","fromNode":"n_check","fromSide":"right","toNode":"n_flip","toSide":"left","color":"6","label":"转反了"},
