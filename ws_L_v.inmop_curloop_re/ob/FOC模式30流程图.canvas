		{"id":"e5","fromNode":"n_dec1s","fromSide":"bottom","toNode":"n_sample","toSide":"top","label":"是（满 1s）"},
		{"id":"e6","fromNode":"n_sample","fromSide":"bottom","toNode":"n_locked","toSide":"top"},
		{"id":"e7","fromNode":"n_locked","fromSide":"bottom","toNode":"n_keep","toSide":"top"},
		{"id":"e8","fromNode":"n_keep","fromSide":"bottom","toNode":"n_product","toSide":"top"},
		{"id":"e9","fromNode":"n_sample","fromSide":"right","toNode":"n_warn","toSide":"left","color":"2","label":"打滑/没跟上时"}
