		{"id":"e5","fromNode":"n_pinch","fromSide":"right","toNode":"n_anchor","toSide":"left","label":"捏稳后"},
		{"id":"e6","fromNode":"n_chk","fromSide":"bottom","toNode":"n_anchor","toSide":"top","label":"检查通过"},
		{"id":"e7","fromNode":"n_anchor","fromSide":"bottom","toNode":"n_run","toSide":"top","label":"PwmStart"},
		{"id":"e8","fromNode":"n_run","fromSide":"bottom","toNode":"n_refgen","toSide":"top"},
		{"id":"e9","fromNode":"n_refgen","fromSide":"right","toNode":"n_ptune","toSide":"left","label":"P-only"},
		{"id":"e10","fromNode":"n_ptune","fromSide":"bottom","toNode":"n_ion","toSide":"top","label":"不振铃后"},
