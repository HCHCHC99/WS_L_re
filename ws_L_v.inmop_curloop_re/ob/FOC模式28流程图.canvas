		{"id":"e7","fromNode":"n_pdroop","fromSide":"bottom","toNode":"n_ion","toSide":"right","label":"落差换电压，I 来清零"},
		{"id":"e8","fromNode":"n_ion","fromSide":"bottom","toNode":"n_ceiling","toSide":"top","label":"空载加速"},
